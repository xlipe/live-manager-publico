# Copie para .env (ou defina no systemd) antes de rodar em servidor público.

# Porta interna (o Nginx faz o proxy para ela)
PORT=8787
# Em servidor, mantenha 127.0.0.1 e exponha só pelo Nginx com HTTPS
HOST=127.0.0.1

# Senha da página de configuração e da API (HTTP Basic; o usuário pode ser qualquer um)
ADMIN_PASSWORD=troque-esta-senha

# Chave que precisa estar nas URLs dos overlays: /overlay/island?key=...
# Gere algo longo e aleatório, por exemplo: openssl rand -hex 24
OVERLAY_KEY=troque-esta-chave

# Conta Google do canal (aba Contas): projeto no Google Cloud com a YouTube Data API v3
# e credencial OAuth "aplicativo web" com retorno https://SEU-DOMINIO/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Conta Twitch do canal (aba Contas): aplicativo em dev.twitch.tv com a URL de retorno
# https://SEU-DOMINIO/api/twitch/callback. Liga seguidores, subs, bits, raids e resgates.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# LivePix e PixGG não usam .env: as credenciais são coladas na aba Contas do painel.
